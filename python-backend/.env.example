APP_NAME="FotoNabidka API"
APP_ENV="development"
APP_DEBUG="true"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./python-backend.db"
DATABASE_URL_SYNC="sqlite:///./python-backend.db"
DB_AUTO_CREATE_SCHEMA="true"
DB_SEED_ON_STARTUP="true"
REDIS_URL="redis://localhost:6379/0"
LOG_LEVEL="INFO"
AI_ANALYSIS_PROVIDER="mock"
# Claude vision provider (doporučeno):
# AI_ANALYSIS_PROVIDER="claude"
# ANTHROPIC_API_KEY="sk-ant-..."
# CLAUDE_VISION_MODEL="claude-opus-4-6"  # volitelné, výchozí je claude-opus-4-6

# Production-oriented PostgreSQL example:
# APP_ENV="production"
# DATABASE_URL="postgresql+asyncpg://novu:novu@localhost:5432/novu_builder"
# DATABASE_URL_SYNC="postgresql+psycopg://novu:novu@localhost:5432/novu_builder"
# DB_AUTO_CREATE_SCHEMA="false"
# DB_SEED_ON_STARTUP="false"
