APP_NAME="FotoNabidka API"
APP_ENV="development"
APP_DEBUG="true"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./python-backend.db"
DATABASE_URL_SYNC="sqlite:///./python-backend.db"
DB_AUTO_CREATE_SCHEMA="true"
DB_SEED_ON_STARTUP="true"
# API DB pool — used exclusively by HTTP request handlers.
# Session lifetime ≈ one HTTP request (~100 ms). Independent from worker pool.
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="10"
DB_POOL_TIMEOUT="30"
DB_POOL_RECYCLE="1800"
REDIS_URL="redis://localhost:6379/0"
REDIS_SOCKET_CONNECT_TIMEOUT="1.0"
REDIS_SOCKET_TIMEOUT="1.0"
REDIS_HEALTH_CHECK_INTERVAL="30"
REDIS_RETRY_ATTEMPTS="3"
REDIS_RETRY_BACKOFF_BASE="0.05"
REDIS_RETRY_BACKOFF_CAP="0.5"
LOG_LEVEL="INFO"
AI_ANALYSIS_PROVIDER="mock"
WORKER_CONCURRENCY="1"
# Worker DB pool (separate engine, isolated from API pool):
#   WORKER_DB_POOL_SIZE=0  → auto-derive from WORKER_CONCURRENCY (recommended)
#   WORKER_DB_POOL_SIZE=N  → explicit; must be >= WORKER_CONCURRENCY or startup FAILS
#   max_overflow is always 0 for the worker pool (predictable, overflow-free)
WORKER_DB_POOL_SIZE="0"
WORKER_DB_POOL_TIMEOUT="30"
# Multi-instance: number of worker processes sharing this DB server
# (e.g. Kubernetes replicas). Logged at startup for capacity visibility.
WORKER_INSTANCE_COUNT="1"
# Password reset email — set to the URL of the web client handling /reset-password
# (no web client deployed by default; configure when adding a web frontend)
# APP_BASE_URL="http://localhost:8000"
# Claude vision provider (doporučeno):
# AI_ANALYSIS_PROVIDER="claude"
# ANTHROPIC_API_KEY="sk-ant-..."
# CLAUDE_VISION_MODEL="claude-opus-4-6"  # volitelné, výchozí je claude-opus-4-6

# Production-oriented PostgreSQL example:
# APP_ENV="production"
# DATABASE_URL="postgresql+asyncpg://novu:novu@localhost:5432/novu_builder"
# DATABASE_URL_SYNC="postgresql+psycopg://novu:novu@localhost:5432/novu_builder"
# DB_AUTO_CREATE_SCHEMA="false"
# DB_SEED_ON_STARTUP="false"
#
# Two independent DB pools (API + worker):
#   API pool:    DB_POOL_SIZE + DB_MAX_OVERFLOW  (HTTP request sessions, ~100 ms)
#   Worker pool: WORKER_CONCURRENCY (auto) or WORKER_DB_POOL_SIZE, max_overflow=0
#
# Worker sessions are NOT held during AI calls (up to 180 s) — no pool starvation.
# To run N workers safely: WORKER_CONCURRENCY=N, WORKER_DB_POOL_SIZE=0 (auto).
# DB_POOL_SIZE="10"
# DB_MAX_OVERFLOW="10"
# DB_POOL_TIMEOUT="30"
# DB_POOL_RECYCLE="1800"
# WORKER_CONCURRENCY="1"
# WORKER_DB_POOL_SIZE="0"      # 0 = auto-derive from WORKER_CONCURRENCY
# WORKER_INSTANCE_COUNT="1"    # set to replica count in multi-pod deployments
# CORS_ALLOWED_ORIGINS="https://app.example.com"
# APP_BASE_URL="https://app.example.com"
# METRICS_AUTH_ENABLED="true"
# METRICS_AUTH_TOKEN="<run: python -c 'import secrets; print(secrets.token_hex(32))'>"
# STORAGE_BACKEND="s3"
# S3_BUCKET="novu-prod-bucket"
# S3_REGION="us-east-1"
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# S3_ACCESS_KEY_ID="<generated-access-key>"
# S3_SECRET_ACCESS_KEY="<generated-secret-key>"
# S3_CDN_BASE_URL="https://cdn.example.com"
