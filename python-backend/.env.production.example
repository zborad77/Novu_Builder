# ============================================================
#  NOVU Builder — Production environment EXAMPLE
#  Copy to .env.production and fill in real values.
#  Start server with: APP_ENV=production uvicorn app.main:app ...
# ============================================================

APP_ENV="production"
APP_DEBUG="false"

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://novu:CHANGE_ME@localhost:5432/novu_prod"
DATABASE_URL_SYNC="postgresql+psycopg://novu:CHANGE_ME@localhost:5432/novu_prod"
DB_AUTO_CREATE_SCHEMA="false"
DB_SEED_ON_STARTUP="false"

# Auth — REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Startup FAILS if JWT_SECRET contains 'change-me' or is shorter than 32 chars.
JWT_SECRET="<run: python -c 'import secrets; print(secrets.token_hex(32))'>"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"

# AI provider
AI_ANALYSIS_PROVIDER="claude"
# ANTHROPIC_API_KEY="sk-ant-..."

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com"

# Password reset email — set to the URL of the web client handling /reset-password
# Required if self-service password reset via email is used.
# APP_BASE_URL="https://app.yourdomain.com"

# HTTPS enforcement (false if reverse proxy handles TLS)
REQUIRE_HTTPS="false"
HSTS_MAX_AGE="31536000"

# Rate limits
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_ADMIN="30/minute"

# Logging (JSON to rotating files)
LOG_LEVEL="WARNING"
LOG_FILE="/var/log/novu/app.log"
LOG_ERROR_FILE="/var/log/novu/error.log"

# Redis — REQUIRED: startup FAILS if no password or placeholder password.
# Format: redis://:yourpassword@host:port/db
REDIS_URL="redis://:<generated-password>@localhost:6379/0"

# Prometheus metrics auth guard — REQUIRED when METRICS_AUTH_ENABLED=true (default).
# Startup FAILS if not set or contains 'change-me'.
METRICS_AUTH_TOKEN="<generated-token>"

# Storage (persistent volume)
STORAGE_ROOT="/var/lib/novu/storage"
