# ============================================================
#  NOVU Builder — Production environment EXAMPLE
#  Copy to .env.production and fill in real values.
#  Start server with: APP_ENV=production uvicorn app.main:app ...
# ============================================================

APP_ENV="production"
APP_DEBUG="false"

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://novu:CHANGE_ME@localhost:5432/novu_prod"
DATABASE_URL_SYNC="postgresql+psycopg://novu:CHANGE_ME@localhost:5432/novu_prod"
DB_AUTO_CREATE_SCHEMA="false"
DB_SEED_ON_STARTUP="false"
#
# Two INDEPENDENT DB pools — API and worker never share connections.
#
# API pool (for HTTP request handlers):
#   Session lifetime ≈ one HTTP request (~100 ms).
#   Size for peak concurrent API requests, not for worker jobs.
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="10"
DB_POOL_TIMEOUT="30"
DB_POOL_RECYCLE="1800"

# Auth — REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Startup FAILS if JWT_SECRET contains 'change-me' or is shorter than 32 chars.
JWT_SECRET="<run: python -c 'import secrets; print(secrets.token_hex(32))'>"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"

# AI provider
AI_ANALYSIS_PROVIDER="claude"
# Worker pool (for background job execution — isolated from API pool):
#   Session lifetime ≈ one short DB unit-of-work (~50 ms).
#   Sessions are NEVER held during AI analysis calls (up to 180 s).
#   max_overflow is always 0: pool is exactly sized, no overflow churn.
#
#   WORKER_DB_POOL_SIZE=0  → auto-derive from WORKER_CONCURRENCY (recommended)
#   WORKER_DB_POOL_SIZE=N  → explicit; startup FAILS if N < WORKER_CONCURRENCY
#
#   Multi-instance (e.g. Kubernetes):
#     total worker connections = WORKER_CONCURRENCY × WORKER_INSTANCE_COUNT
#     Ensure PostgreSQL max_connections > (total worker + API pool).
# Pilot/runtime profile:
# This file is authoritative only for direct backend/worker startup from
# python-backend/. For docker-compose deployments, the root .env.production is
# the authoritative source and should contain the same values explicitly.
WORKER_CONCURRENCY="2"
WORKER_HEAVY_CONCURRENCY="1"
WORKER_JOB_LEASE_TIMEOUT_SECONDS="600"
WORKER_HEAVY_JOB_LEASE_TIMEOUT_SECONDS="1800"
WORKER_JOB_REAP_INTERVAL_SECONDS="30"
WORKER_HEAVY_JOB_REAP_INTERVAL_SECONDS="30"
READINESS_PROCESSING_GRACE_SECONDS="75"
ANALYSIS_QUEUE_MAX_DEPTH="100"
HEAVY_QUEUE_MAX_DEPTH="50"
ANALYSIS_JOB_MAX_ATTEMPTS="3"
ANALYSIS_RETRY_BACKOFF_BASE_SECONDS="30"
ANALYSIS_RETRY_BACKOFF_MAX_SECONDS="300"
ANALYSIS_JOBS_PER_TENANT_LIMIT="10"
WORKER_DB_POOL_SIZE="0"
WORKER_DB_POOL_TIMEOUT="30"
WORKER_INSTANCE_COUNT="1"
# Explicit single-node pilot topology. Leave empty only intentionally.
REDIS_FAILOVER_URLS=""
# ANTHROPIC_API_KEY="sk-ant-..."

# Redis client tuning
REDIS_SOCKET_CONNECT_TIMEOUT="1.0"
REDIS_SOCKET_TIMEOUT="1.0"
REDIS_HEALTH_CHECK_INTERVAL="30"
REDIS_RETRY_ATTEMPTS="3"
REDIS_RETRY_BACKOFF_BASE="0.05"
REDIS_RETRY_BACKOFF_CAP="0.5"

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com"

# Base URL of the deployment — REQUIRED: startup fails if empty, localhost,
# example.com, or placeholder domains like app.yourdomain.com.
# Self-service reset is currently retired (HTTP 410); set this to your deployed
# base URL regardless (guard runs in production/staging for all APP_ENV values).
APP_BASE_URL="https://app.yourdomain.com"

# HTTPS enforcement (false if reverse proxy handles TLS)
REQUIRE_HTTPS="false"
HSTS_MAX_AGE="31536000"
CSP_ENABLED="true"

# Rate limits
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_ADMIN="30/minute"
RATE_LIMIT_ADMIN_WRITE="10/minute"
RATE_LIMIT_ADMIN_SENSITIVE="5/minute"
RATE_LIMIT_UPLOAD="30/minute"
RATE_LIMIT_ANALYSIS_JOBS="20/minute"
RATE_LIMIT_READ_LIST="120/minute"
RATE_LIMIT_READ_DETAIL="60/minute"

# Logging (JSON to rotating files)
LOG_LEVEL="WARNING"
LOG_FILE="/var/log/novu/app.log"
LOG_ERROR_FILE="/var/log/novu/error.log"

# Redis — REQUIRED: startup FAILS if no password or placeholder password.
# Format: redis://:yourpassword@host:port/db
REDIS_URL="redis://:<generated-password>@localhost:6379/0"
REDIS_SOCKET_CONNECT_TIMEOUT="1.0"
REDIS_SOCKET_TIMEOUT="1.0"
REDIS_HEALTH_CHECK_INTERVAL="30"
REDIS_RETRY_ATTEMPTS="3"
REDIS_RETRY_BACKOFF_BASE="0.05"
REDIS_RETRY_BACKOFF_CAP="0.5"

# Prometheus metrics auth guard — REQUIRED and must stay enabled in production.
# Startup FAILS if not set, disabled, or left as a template value like <generated-token>.
METRICS_AUTH_ENABLED="true"
METRICS_AUTH_TOKEN="<generated-token>"
WORKER_METRICS_ENABLED="true"
WORKER_METRICS_HOST="0.0.0.0"
WORKER_METRICS_PORT="9101"

# Error monitoring — explicit even when intentionally disabled.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
SENTRY_PROFILES_SAMPLE_RATE="0.0"

# Storage — REQUIRED in non-dev/test: S3 is the only authoritative production storage.
STORAGE_BACKEND="s3"
STORAGE_AUTHORITATIVE="true"
S3_CONNECT_TIMEOUT_SECONDS="3"
S3_READ_TIMEOUT_SECONDS="10"
STORAGE_SIGNED_URL_TTL_SECONDS="3600"
EXPORT_TTL_DAYS="7"
S3_BUCKET="novu-prod-bucket"
S3_REGION="us-east-1"
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# S3_ACCESS_KEY_ID="<generated-access-key>"
# S3_SECRET_ACCESS_KEY="<generated-secret-key>"

# Note: docker-compose.yml may still mount a local storage volume for compatibility,
# but in production S3 remains the only source of truth. Local storage is DEV/TEST only.
