# =============================================================================
# NOVU Builder — Production / Pilot environment template
# =============================================================================
# Copy to .env.production and fill in every CHANGE_ME / REPLACE_WITH value.
# Then verify no placeholders remain:
#   grep -Ei "CHANGE_ME|change.me|REPLACE_WITH|placeholder" .env.production
#
# Generate secrets before filling in this file:
#   JWT_SECRET        : openssl rand -hex 32
#   METRICS_AUTH_TOKEN: openssl rand -hex 32
#   POSTGRES password : openssl rand -hex 24
#   REDIS password    : openssl rand -hex 24
#
# Strict validation fires for any APP_ENV other than 'development' or 'test'.
# Every field below marked [REQUIRED-STRICT] MUST be present in the file even
# when the value equals the default, otherwise startup will fail.
#
# STORAGE NOTE: STORAGE_BACKEND=local is rejected in any strict environment.
# For an internal pilot without AWS S3, run MinIO in docker-compose and use
# STORAGE_BACKEND=s3 + S3_ENDPOINT_URL=http://minio:9000 (see below).
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=NOVU Builder
APP_VERSION=0.6.003
APP_DEBUG=false
API_V1_PREFIX=/api/v1
# Base URL of the deployed web client — must not be localhost in strict env
APP_BASE_URL=https://pilot.yourdomain.example.com


# -----------------------------------------------------------------------------
# Database  (PostgreSQL required — SQLite rejected in strict environments)
# Async URL (used by API + worker engines):
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Generate password: openssl rand -hex 24
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://novu:CHANGE_ME_db_password@db:5432/novu_db
# DATABASE_URL_SYNC=  # leave empty — derived automatically from DATABASE_URL

DB_AUTO_CREATE_SCHEMA=false
DB_SEED_ON_STARTUP=false

# [REQUIRED-STRICT] DB connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# -----------------------------------------------------------------------------
# Redis  (authenticated URL required in strict environments)
# Format: redis://:PASSWORD@HOST:6379/DB
# Generate password: openssl rand -hex 24
# -----------------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# [REQUIRED-STRICT] Leave empty unless you have Redis Sentinel / failover nodes
REDIS_FAILOVER_URLS=

# [REQUIRED-STRICT] Redis client tuning
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_BACKOFF_BASE=0.05
REDIS_RETRY_BACKOFF_CAP=0.5


# -----------------------------------------------------------------------------
# Auth / JWT
# Generate: openssl rand -hex 32  (min 32 chars required)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# [REQUIRED-STRICT] Token lifetimes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# CORS / Security hardening
# CORS_ALLOWED_ORIGINS must not be localhost-only in strict environments.
# Comma-separated: https://app.example.com,https://admin.example.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://pilot.yourdomain.example.com

# [REQUIRED-STRICT]
REQUIRE_HTTPS=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true


# -----------------------------------------------------------------------------
# Rate limiting  [REQUIRED-STRICT]  format: count/window
# Valid windows: second, minute, hour, day
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ADMIN=60/minute
RATE_LIMIT_ADMIN_WRITE=10/minute
RATE_LIMIT_ADMIN_SENSITIVE=5/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_ANALYSIS_JOBS=20/minute
RATE_LIMIT_MARKER_WRITE=30/minute
RATE_LIMIT_METRICS=60/minute
RATE_LIMIT_READ_LIST=120/minute
RATE_LIMIT_READ_DETAIL=60/minute


# -----------------------------------------------------------------------------
# AI Analysis provider  [REQUIRED-STRICT]
# Options: anthropic | openai | mock
# 'mock' requires no API key and is safe for a UI-only pilot.
# -----------------------------------------------------------------------------
AI_ANALYSIS_PROVIDER=anthropic

# Required when AI_ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME_real_anthropic_api_key

# Required when AI_ANALYSIS_PROVIDER=openai (leave empty otherwise)
# OPENAI_API_KEY=

# Optional: cap AI calls per tenant per day (0 = unlimited)
AI_ANALYSIS_DAILY_QUOTA_PER_TENANT=0


# -----------------------------------------------------------------------------
# Worker  [REQUIRED-STRICT]
# WORKER_CONCURRENCY: standard analysis jobs
# WORKER_HEAVY_CONCURRENCY: 0 disables the heavy lane (exports / media)
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_HEAVY_CONCURRENCY=1
WORKER_JOB_LEASE_TIMEOUT_SECONDS=600
WORKER_HEAVY_JOB_LEASE_TIMEOUT_SECONDS=1800
WORKER_JOB_REAP_INTERVAL_SECONDS=30
WORKER_HEAVY_JOB_REAP_INTERVAL_SECONDS=30
READINESS_PROCESSING_GRACE_SECONDS=75
ANALYSIS_QUEUE_MAX_DEPTH=1000
HEAVY_QUEUE_MAX_DEPTH=250
# 0 = auto-derive from worker concurrency (recommended)
BACKPRESSURE_MAX_CONCURRENT_JOBS=0
BACKPRESSURE_MAX_QUEUED_JOBS=0
BACKPRESSURE_MAX_RETRY_INFLIGHT=0
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_RETRY_BACKOFF_BASE_SECONDS=30
ANALYSIS_RETRY_BACKOFF_MAX_SECONDS=300
ANALYSIS_JOBS_PER_TENANT_LIMIT=10
ANALYSIS_JOB_INLINE_PAYLOAD_MAX_BYTES=32768
CASES_PAGE_LIMIT_MAX=200

# Worker-dedicated DB pool (0 = auto-derive from WORKER_CONCURRENCY)
WORKER_DB_POOL_SIZE=0
WORKER_DB_POOL_TIMEOUT=30
# Number of worker processes pointing at this DB server (pods × replicas)
WORKER_INSTANCE_COUNT=1

# Upload limit
MAX_UPLOAD_SIZE_MB=20


# -----------------------------------------------------------------------------
# Storage  [REQUIRED-STRICT]
#
# STORAGE_BACKEND=local is REJECTED in any strict environment (production,
# staging, pilot).  Use STORAGE_BACKEND=s3.
#
# Option A — AWS S3:
#   S3_ENDPOINT_URL=   (leave empty)
#   S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY = IAM user credentials
#   or omit both to use EC2 instance role / ECS task role
#
# Option B — MinIO (self-hosted, add to docker-compose.yml):
#   S3_ENDPOINT_URL=http://minio:9000
#   S3_ACCESS_KEY_ID=minio_access_key
#   S3_SECRET_ACCESS_KEY=minio_secret_key
# -----------------------------------------------------------------------------
STORAGE_BACKEND=s3
STORAGE_ROOT=

S3_BUCKET=CHANGE_ME_bucket_name
S3_REGION=eu-central-1
# For AWS S3 leave empty; for MinIO/R2/other set the endpoint URL
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=CHANGE_ME_access_key_id
S3_SECRET_ACCESS_KEY=CHANGE_ME_secret_access_key
# S3_CDN_BASE_URL — DO NOT set; incompatible with signed URL policy
S3_CDN_BASE_URL=

S3_CONNECT_TIMEOUT_SECONDS=3.0
S3_READ_TIMEOUT_SECONDS=10.0
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_AUTHORITATIVE=true
EXPORT_TTL_DAYS=7


# -----------------------------------------------------------------------------
# Prometheus metrics  [REQUIRED-STRICT]
# Generate token: openssl rand -hex 32  (min 32 chars)
# Configure Prometheus scrape_configs with bearer_token to match.
# -----------------------------------------------------------------------------
METRICS_AUTH_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
# Optional: restrict scraping to specific IPs/CIDRs (empty = no IP restriction)
# METRICS_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16

# Worker metrics endpoint — required in strict environments
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9101


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional: absolute path for access log and error log
LOG_FILE=
LOG_ERROR_FILE=


# -----------------------------------------------------------------------------
# Email / SMTP  (optional — leave empty to disable transactional email)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.example.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# Sentry error monitoring  (optional — leave empty to disable)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
