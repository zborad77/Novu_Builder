# Zkopíruj do .env.production a vyplň hodnoty
# docker compose --env-file .env.production up -d

# PostgreSQL heslo (vygeneruj náhodné, např: openssl rand -hex 32)
POSTGRES_PASSWORD=change-me

# Redis heslo (vygeneruj náhodné, např: openssl rand -hex 32)
REDIS_PASSWORD=change-me

# JWT tajný klíč (vygeneruj náhodné, např: openssl rand -hex 32)
JWT_SECRET=change-me

# Browser client URL a CORS whitelist (required outside development/test)
# Např. https://app.example.com nebo více URL oddělených čárkou.
APP_BASE_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# AI provider: mock | claude | openai
AI_ANALYSIS_PROVIDER=mock

# Pokud AI_ANALYSIS_PROVIDER=claude:
# ANTHROPIC_API_KEY=sk-ant-...

# Prometheus /metrics auth guard (vygeneruj náhodné, např: openssl rand -hex 32)
# Prometheus scrape_configs musí přidat: bearer_token: <stejná hodnota>
METRICS_AUTH_ENABLED=true
METRICS_AUTH_TOKEN=change-me

# Produkční storage backend: S3 je jediný authoritative source of truth.
STORAGE_BACKEND=s3
STORAGE_AUTHORITATIVE=true
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
STORAGE_SIGNED_URL_TTL_SECONDS=3600
EXPORT_TTL_DAYS=7
S3_BUCKET=change-me-bucket
S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Poznámka:
# docker-compose.yml kvůli kompatibilitě stále mountuje storage_data volume,
# ale v produkci je ignorováno jako source of truth. Local storage je jen pro DEV/TEST.
