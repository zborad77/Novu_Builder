# Zkopíruj do .env.production a vyplň hodnoty
# docker compose --env-file .env.production up -d

# PostgreSQL heslo (vygeneruj náhodné, např: openssl rand -hex 32)
POSTGRES_PASSWORD=change-me

# Redis heslo (vygeneruj náhodné, např: openssl rand -hex 32)
REDIS_PASSWORD=change-me

# JWT tajný klíč (vygeneruj náhodné, např: openssl rand -hex 32)
JWT_SECRET=change-me

# Browser client URL a CORS whitelist (required outside development/test)
# Např. https://app.example.com nebo více URL oddělených čárkou.
APP_BASE_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Pilot runtime profile:
# root .env.production is the authoritative source for docker-compose runtime knobs.
# Even intentionally conservative or disabled values must stay explicit here.

# AI provider: mock | claude | openai
AI_ANALYSIS_PROVIDER=mock

# Pokud AI_ANALYSIS_PROVIDER=claude:
# ANTHROPIC_API_KEY=sk-ant-...

# Worker / queue orchestration
# Explicit pilot profile: do not rely on backend defaults.
WORKER_CONCURRENCY=2
WORKER_HEAVY_CONCURRENCY=1
WORKER_JOB_LEASE_TIMEOUT_SECONDS=600
WORKER_HEAVY_JOB_LEASE_TIMEOUT_SECONDS=1800
WORKER_JOB_REAP_INTERVAL_SECONDS=30
WORKER_HEAVY_JOB_REAP_INTERVAL_SECONDS=30
READINESS_PROCESSING_GRACE_SECONDS=75
ANALYSIS_QUEUE_MAX_DEPTH=100
HEAVY_QUEUE_MAX_DEPTH=50
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_RETRY_BACKOFF_BASE_SECONDS=30
ANALYSIS_RETRY_BACKOFF_MAX_SECONDS=300
ANALYSIS_JOBS_PER_TENANT_LIMIT=10
WORKER_DB_POOL_SIZE=0
WORKER_DB_POOL_TIMEOUT=30
WORKER_INSTANCE_COUNT=1

# Topologie:
# prázdné REDIS_FAILOVER_URLS + WORKER_INSTANCE_COUNT=1 = explicitní single-node pilot profil.
# Pro HA profil vyplň další redis endpointy oddělené čárkou a uprav WORKER_INSTANCE_COUNT.
REDIS_FAILOVER_URLS=

# API / worker DB pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis client tuning
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_BACKOFF_BASE=0.05
REDIS_RETRY_BACKOFF_CAP=0.5

# Token lifetime
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Transport / browser security
REQUIRE_HTTPS=false
HSTS_MAX_AGE=31536000

# Rate limits / abuse protection
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_ADMIN=30/minute
RATE_LIMIT_ADMIN_WRITE=10/minute
RATE_LIMIT_ADMIN_SENSITIVE=5/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_ANALYSIS_JOBS=20/minute

# Prometheus /metrics auth guard (vygeneruj náhodné, např: openssl rand -hex 32)
# Prometheus scrape_configs musí přidat: bearer_token: <stejná hodnota>
METRICS_AUTH_ENABLED=true
METRICS_AUTH_TOKEN=change-me
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9101

# Error monitoring / observability
# Nastav reálné DSN pro pilot; prázdná hodnota je pouze explicitní vypnutí.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Produkční storage backend: S3 je jediný authoritative source of truth.
STORAGE_BACKEND=s3
STORAGE_AUTHORITATIVE=true
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
STORAGE_SIGNED_URL_TTL_SECONDS=3600
EXPORT_TTL_DAYS=7
S3_BUCKET=change-me-bucket
S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Poznámka:
# docker-compose.yml kvůli kompatibilitě stále mountuje storage_data volume,
# ale v produkci je ignorováno jako source of truth. Local storage je jen pro DEV/TEST.
