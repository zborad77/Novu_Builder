#pragma once

// Novu Builder Desktop -- verze aplikace
//
// Format: MAJOR.MINOR.PATCH
//   MAJOR -- architekturalni zmeny, breaking changes
//   MINOR -- nova funkcionalita
//   PATCH -- bugfixy, drobne upravy
//
// Neupravujte rucne -- generovano z version.json pres CMake.

#define NOVU_VERSION_MAJOR @NOVU_VERSION_MAJOR@
#define NOVU_VERSION_MINOR @NOVU_VERSION_MINOR@
#define NOVU_VERSION_PATCH @NOVU_VERSION_PATCH@

#define NOVU_VERSION_STR "@NOVU_VERSION_MAJOR@.@NOVU_VERSION_MINOR@.@NOVU_VERSION_PATCH@"
