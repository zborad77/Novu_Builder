# Bare-metal Private Core overrides (F6.5). Applied on top of
# python-backend/.env.production.example when building /etc/novuconstruct/core.env
# (see README.md "Install"). No secrets here: they live in
# /etc/novuconstruct/secrets/* (0640 root:novuconstruct) and reach the process via
# systemd LoadCredential + bin/nc-run.
#
# NC_ZONE is NOT set here: each systemd instance sets it (nc-api@<zone>).

APP_ENV=production

# nginx reaches the API over unix sockets only (uvicorn --uds); "unix" trusts
# that peer, whose access is limited by the socket's file permissions.
TRUSTED_PROXY_IPS=unix

# Core is reached through WireGuard + nginx on the WG address; TLS for the
# Public Edge terminates on the edge nginx. HSTS stays on for responses relayed
# by the gateway (F4).
REQUIRE_HTTPS=false

# Private services on loopback only.
S3_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_BACKEND=s3
STORAGE_AUTHORITATIVE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Out-of-database purge ledger (docs/security/PHOTO_DELETION.md §5); ship off-host.
PHOTO_PURGE_LEDGER_PATH=/var/lib/novuconstruct/photo-purge-ledger.jsonl

JWT_ISSUER=novuconstruct-core
