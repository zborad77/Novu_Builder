# Web Gateway (BFF) – /etc/nc-gateway/gateway.env (0640 root:nc-gateway).
# Template for deploy/linux/provision/nc-provision (builds the real file from
# this one + provision.conf; operator overrides go to /etc/nc-gateway/gateway.env.local).
# Contract: docs/security/NC-007_STAGE1_CONTRACT.md §2–5, §8.
#
# NO SECRETS HERE. These come only via systemd LoadCredential + bin/nc-run
# (nc-gateway.service), from /etc/nc-gateway/secrets (0600 root:root):
#   NC_GATEWAY_HMAC_KEY   kid:secret (= one entry of the core's NC_GATEWAY_HMAC_KEYS)
#   NC_BFF_SESSION_KEYS   kid:base64(32 B)[,kid:base64(32 B)…]
#   NC_BFF_REDIS_URL      unix://nc-gateway:<password>@/run/nc-gateway-redis/redis.sock?db=0
# A value for any of them in this file is refused by nc-provision.

# Anything but "development" is strict: missing variable, key < 32 B, non-https
# origin or missing allowlist = the process refuses to start (contract §8).
NC_ENV=production

# Exact origin of the SPA (scheme + host, no path, no trailing slash). Origin
# check for mutations compares against this byte for byte.
NC_BFF_PUBLIC_ORIGIN=https://app.example.invalid

# Core zone "gateway", HMAC-signed (GATEWAY_CORE_CONTRACT.md):
#   variant A (two servers): http://10.50.0.1:8200  (WireGuard wg-nc, peer 10.50.0.2)
#   variant B (one server):  http://127.0.0.1:8200  (core nginx gateway vhost on loopback,
#                            nftables: only uid nc-gateway may connect)
NC_BFF_CORE_URL=http://10.50.0.1:8200

# The ONLY trusted proxy: the local nginx. X-Forwarded-For is read only from a
# connection coming from this address, and only its last value is used.
NC_BFF_TRUSTED_PROXY=127.0.0.1

# Listener of the gateway itself (nginx upstream nc_gateway in nc-edge-webapp.conf).
# Loopback only; nftables lets only nginx (www-data) and root connect.
NC_BFF_LISTEN_HOST=127.0.0.1
NC_BFF_LISTEN_PORT=8300

# Pass-through allowlist (generated from exposure.py, zone gateway). Missing,
# unreadable or empty file = the process does not start.
NC_BFF_ALLOWLIST_PATH=/opt/novuconstruct/docs/security/gateway-allowlist.json

# Session lifetime: idle 30 min, absolute 12 h (absolute is never extended).
NC_BFF_IDLE_TIMEOUT_SECONDS=1800
NC_BFF_ABSOLUTE_TIMEOUT_SECONDS=43200

# Timeout of one core request (s; gateway default 30). Uploads and exports can be
# slow; keep it below nginx proxy_read_timeout of /bff/ (310 s, nc-proxy-bff.conf).
NC_BFF_CORE_TIMEOUT_SECONDS=110
# SSE streams (text/event-stream): idle limit instead of the request timeout.
# nginx proxy_read_timeout (310 s) must stay above it.
NC_BFF_SSE_IDLE_TIMEOUT_SECONDS=300

# Routes that accept multipart up to 25 MiB (contract §4.2). Unset = the gateway's
# built-in list (POST …/images, POST …/upload*). Format: "POST /api/v1/...,POST /api/v1/...".
# NC_BFF_UPLOAD_ROUTES=

# NC_BFF_DEV_INSECURE_COOKIE is deliberately absent: only NC_ENV=development may
# set it (=1, cookie nc_sid_dev without Secure); anywhere else the gateway refuses
# to start with it, and nc-provision refuses to write it.
