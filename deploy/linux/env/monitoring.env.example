# Author: Pavel Dostál
# Project: NovuConstruct
# Module: deploy/linux/env
# Description: Šablona /etc/novuconstruct/monitoring.env pro bin/nc-wg-metrics (T7.2, F9.3).
#              Bez souboru platí výchozí hodnoty níže. Neobsahuje secrets.
# Created: 2026-11-13
#
# Instalace: install -m 0644 -o root -g root deploy/linux/env/monitoring.env.example \
#              /etc/novuconstruct/monitoring.env
# Změna se projeví při dalším běhu nc-wg-metrics.timer (do 1 minuty).

# Rozhraní, která musí existovat a být nahoře (alert WireGuardInterfaceDown).
# Alert WireGuardInterfaceNotMonitored hlídá wg-nc a wg-nc-admin vždy, i když tu chybí.
NC_WG_INTERFACES="wg-nc wg-nc-admin"

# Nejdelší povolená doba v sekundách, po kterou může být rozhraní nahoře bez
# handshaku s jakýmkoli peerem (alert WireGuardNoHandshake). 0 = alert vypnutý.
# WireGuard obnovuje handshake zhruba každé 2 minuty, dokud peer posílá provoz
# (edge má PersistentKeepalive=25), 900 s tedy znamená několik vynechaných obnov.
NC_WG_HANDSHAKE_MAX_AGE=900

# Limity pro jednotlivá rozhraní, mezerou oddělené "rozhraní:sekundy". Varianta
# single bez edge: desktopy se přes noc odpojují, správci se připojují jen občas.
#NC_WG_HANDSHAKE_MAX_AGE_OVERRIDES="wg-nc:43200 wg-nc-admin:0"

# Volitelně peery, které musí mít čerstvý handshake (alert WireGuardRequiredPeerStale),
# mezerou oddělené "rozhraní:veřejný klíč", např. edge server ve variantě core/edge.
#NC_WG_REQUIRED_PEERS="wg-nc:<veřejný klíč edge>"
