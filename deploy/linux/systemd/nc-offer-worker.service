# NovuConstruct offer worker: AI offer pipeline (offer queue), AI budget sweeper,
# offer reconciler and the transactional outbox publisher (SSE live delivery).
# Serves no HTTP traffic, needs no zone and opens no listening port.
# Without it offer requests are accepted but never processed (REFACTOR_FINDINGS N2).
[Unit]
Description=NovuConstruct offer worker
After=network-online.target postgresql.service redis-server.service minio.service
Wants=network-online.target
PartOf=nc-core.target

[Service]
Type=exec
User=novuconstruct
Group=novuconstruct
UMask=0027
WorkingDirectory=/opt/novuconstruct/src/backend
EnvironmentFile=/etc/novuconstruct/core.env
LoadCredential=JWT_SECRET:/etc/novuconstruct/secrets/JWT_SECRET
LoadCredential=DATABASE_URL:/etc/novuconstruct/secrets/DATABASE_URL
LoadCredential=DATABASE_URL_SYNC:/etc/novuconstruct/secrets/DATABASE_URL_SYNC
LoadCredential=REDIS_URL:/etc/novuconstruct/secrets/REDIS_URL_WORKER
LoadCredential=S3_ACCESS_KEY_ID:/etc/novuconstruct/secrets/S3_ACCESS_KEY_ID
LoadCredential=S3_SECRET_ACCESS_KEY:/etc/novuconstruct/secrets/S3_SECRET_ACCESS_KEY
LoadCredential=METRICS_AUTH_TOKEN:/etc/novuconstruct/secrets/METRICS_AUTH_TOKEN
LoadCredential=ANTHROPIC_API_KEY:/etc/novuconstruct/secrets/ANTHROPIC_API_KEY
StateDirectory=novuconstruct
StateDirectoryMode=0750
ExecStart=/opt/novuconstruct/deploy/linux/bin/nc-run \
    /opt/novuconstruct/src/backend/.venv/bin/python -m app.worker.offer_runner
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/novuconstruct

[Install]
WantedBy=nc-core.target
