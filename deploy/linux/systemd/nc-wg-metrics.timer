# Project: NovuConstruct
# Module: deploy/linux/systemd
# Description: Runs nc-wg-metrics.service every minute (F9.3).
# Created: 2026-11-13
[Unit]
Description=Refresh NovuConstruct WireGuard metrics every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=nc-wg-metrics.service

[Install]
WantedBy=timers.target
