# Private Core application processes. Pilot: desktop + admin zones and the worker.
# The offer worker (nc-offer-worker) is enabled explicitly by `nc-provision
# offer-worker` after its backlog was reviewed – it is not started by this target.
# Gateway zone (nc-api@gateway) is added in F4 together with the Public Edge gateway.
[Unit]
Description=NovuConstruct Private Core
Wants=nc-api@desktop.service nc-api@admin.service nc-worker.service
After=network-online.target

[Install]
WantedBy=multi-user.target
