# Module: deploy/linux/systemd
# Description: WireGuard interface and handshake metrics for node_exporter (bin/nc-wg-metrics, F9.3).
# Created: 2026-11-13
[Unit]
Description=NovuConstruct WireGuard metrics (textfile collector)

[Service]
Type=oneshot
EnvironmentFile=-/etc/novuconstruct/monitoring.env
ExecStart=/opt/novuconstruct/deploy/linux/bin/nc-wg-metrics
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
ReadWritePaths=/var/lib/prometheus/node-exporter
