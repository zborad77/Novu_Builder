# /etc/novuconstruct/provision.conf – konfigurace pro deploy/linux/provision/nc-provision (F6.2).
# Čtou se jen řádky NC_*=hodnota; soubor se nevykonává jako skript.

# single = pilot na jednom serveru (varianta B); core / edge = cílová produkce (varianta A).
NC_VARIANT=single

# Release aplikace (vlastník root, pro služby jen pro čtení) a data MIMO něj.
NC_APP_DIR=/opt/novuconstruct
# Data objektového úložiště. Samostatné šifrované volume (F6.7, LUKS), připojené sem.
NC_DATA_ROOT=/srv/novuconstruct

NC_PG_VERSION=16
NC_S3_BUCKET=novuconstruct
NC_REDIS_MAXMEMORY=512mb

# Objektové úložiště (S-1, docs/security/OBJECT_STORAGE_OPTIONS.md): úložiště běží na
# tomto serveru. garage = install nainstaluje Garage (nc-garage.service, jen 127.0.0.1),
# založí bucket NC_S3_BUCKET a klíč aplikace; start spustí API až po zdravém úložišti.
# external = úložiště provozuje operátor (S3_* v secrets a core.env.local míří na něj).
NC_OBJECT_STORAGE=garage
# Release Garage a SHA-256 jeho binárky (x86_64-unknown-linux-musl nebo aarch64-…)
# z oficiální stránky release. Bez platného SHA-256 install binárku nestáhne.
NC_GARAGE_VERSION=v2.3.0
NC_GARAGE_SHA256=
# Prázdné = https://garagehq.deuxfleurs.fr/_releases/<verze>/<arch>/garage;
# offline: absolutní cesta k ověřené binárce (SHA-256 se kontroluje i tak).
NC_GARAGE_URL=
# Kapacita uzlu v layoutu (např. 200G); prázdné = 90 % velikosti NC_DATA_ROOT.
NC_GARAGE_CAPACITY=

# Edge / single: veřejná doména informačního webu a e-mail pro Let's Encrypt.
NC_DOMAIN=
NC_ACME_EMAIL=

# Core: instance nc-api@gateway + nginx zóna gateway (varianta A 10.50.0.1:8200,
# varianta B 127.0.0.1:8200); vyžaduje NC_GATEWAY_HMAC_KEYS (generuje nc-gen-secrets).
NC_ENABLE_GATEWAY_ZONE=0

# Edge / single: Web Gateway (BFF, NC-007). 1 = install připraví účty nc-gateway a
# nc-gw-redis, secrets v /etc/nc-gateway/secrets, vlastní Redis, venv, gateway.env,
# jednotky a nginx vhost aplikace. NIC nespustí: to dělá jen
#   NC_CONFIRM_GATEWAY=1 nc-provision gateway        (deploy/linux/GATEWAY_RUNBOOK.md)
NC_ENABLE_GATEWAY=0
# Host webové aplikace (SPA + /bff/); NC_BFF_PUBLIC_ORIGIN = https://<NC_APP_DOMAIN>.
NC_APP_DOMAIN=
# Prázdné = podle varianty: edge http://10.50.0.1:8200, single http://127.0.0.1:8200.
NC_GATEWAY_CORE_URL=

# 1 = venv připravil operátor offline (pip se nespouští).
NC_SKIP_PIP=0
