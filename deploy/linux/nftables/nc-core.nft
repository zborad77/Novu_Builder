#!/usr/sbin/nft -f
# NovuConstruct – Private Core server of the TWO-server production variant (A).
# No TCP port on the public interface at all: only WireGuard handshakes (and
# break-glass SSH from the Hetzner console). Validate: nft -c -f nc-core.nft

# Only the NovuConstruct table is replaced (T5.1): no `flush ruleset`, tables of
# other services on the host stay untouched. `table` + `delete table` make the
# reload idempotent – the old table goes away in the same atomic transaction.
table inet nc
delete table inet nc

table inet nc {
    set gateway_peer  { type ipv4_addr; elements = { 10.50.0.2 } }
    set desktop_peers { type ipv4_addr; flags interval; elements = { 10.50.16.0/20 } }
    set admin_peers   { type ipv4_addr; flags interval; elements = { 10.51.0.10-10.51.0.99 } }
    set monitor_peer  { type ipv4_addr; elements = { 10.51.0.5 } }
    set ssh_emergency { type ipv4_addr; flags timeout; }
    set egress_https  { type ipv4_addr; flags interval, timeout; }
    set egress_smtp   { type ipv4_addr; flags interval, timeout; }
    set backup_target { type ipv4_addr; flags interval; }

    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } limit rate 10/second accept

        iifname != { "wg-nc", "wg-nc-admin" } udp dport { 51830, 51831 } accept
        iifname != { "wg-nc", "wg-nc-admin" } tcp dport 22 ip saddr @ssh_emergency accept

        # Gateway zone only from the edge server (enabled in F4).
        iifname "wg-nc" ip saddr @gateway_peer  tcp dport 8200 accept
        iifname "wg-nc" ip saddr @desktop_peers tcp dport 8210 accept
        iifname "wg-nc-admin" ip saddr @admin_peers  tcp dport { 22, 8220 } accept
        iifname "wg-nc-admin" ip saddr @monitor_peer tcp dport { 8220, 9100 } accept

        limit rate 5/minute log prefix "nc-core-drop-in " level info
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;

        oif "lo" accept
        ct state established,related accept
        oifname { "wg-nc", "wg-nc-admin" } accept
        meta l4proto { icmp, ipv6-icmp } accept
        udp dport { 53, 123 } accept
        tcp dport 53 accept
        meta skuid { 0, "_apt" } tcp dport { 80, 443 } accept
        meta skuid "novuconstruct" tcp dport 443 ip daddr @egress_https accept
        meta skuid "novuconstruct" tcp dport { 465, 587 } ip daddr @egress_smtp accept
        meta skuid 0 tcp dport { 22, 23 } ip daddr @backup_target accept

        limit rate 5/minute log prefix "nc-core-drop-out " level info
    }
}
