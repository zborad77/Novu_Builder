#!/bin/sh
# Generate NovuConstruct secrets on the server (F6.5, NC-007; used by provision/nc-provision).
# Run as root. Values are never logged; only file names are printed. The single
# exception is --export-gateway-hmac, which prints ONE key on purpose so that it
# can be piped to the edge server (two-server variant, GATEWAY_RUNBOOK.md).
#
# Private Core (default) – /etc/nc-gateway is never touched:
#   nc-gen-secrets                         create missing core secrets
#   nc-gen-secrets --rotate NAME           rotate one core secret (then reconfigure + restart its user)
#   nc-gen-secrets --add-gateway-hmac      append a new "gw-<date>-<hex>:<64 hex>" to NC_GATEWAY_HMAC_KEYS
#   nc-gen-secrets --drop-gateway-hmac KID remove one entry (refuses to remove the last one)
#   nc-gen-secrets --export-gateway-hmac [KID]   print "kid:secret" (default: the newest entry)
#   → /etc/novuconstruct/secrets/<NAME>, dir 0750 root:novuconstruct, files 0640 root:novuconstruct
#
# Web Gateway (NC-007 §8) – /etc/novuconstruct is never written:
#   nc-gen-secrets --gateway                         create missing gateway secrets
#   nc-gen-secrets --gateway --hmac-from-core [KID]  single server: copy ONE entry of the core's
#                                                    NC_GATEWAY_HMAC_KEYS (default: the newest)
#   nc-gen-secrets --gateway --hmac-stdin            two servers: read "kid:secret" from stdin
#   nc-gen-secrets --gateway --rotate-session-key    new session key first, previous one kept
#                                                    for decryption only (no logout)
#   nc-gen-secrets --gateway --revoke-session-keys   ONE new key, old ones dropped: every web
#                                                    session becomes undecryptable (= logout all)
#   nc-gen-secrets --gateway --rotate-redis-password new ACL password for the gateway Redis
#   → /etc/nc-gateway/secrets/<NAME>, dir 0700 root:root, files 0600 root:root. Only PID 1
#     reads them (LoadCredential); neither the gateway user nor any core user can.
#   NC_GATEWAY_HMAC_KEY  kid:secret        NC_BFF_SESSION_KEYS  kid:base64(32 B)[,…]
#   REDIS_GATEWAY_PASSWORD, NC_BFF_REDIS_URL, and /etc/nc-gateway-redis/users.acl
#   (ACL file of nc-gateway-redis.service: password only as SHA-256, keys ~nc:bff:*).
#
# Object store (Garage, S-1) – /etc/novuconstruct is never written:
#   nc-gen-secrets --garage                create missing Garage secrets
#   → /etc/nc-garage/secrets/<NAME>, dir 0700 root:root, files 0600 root:root. Only PID 1
#     (LoadCredential of nc-garage.service) and root's garage CLI read them.
#   GARAGE_RPC_SECRET (32 B hex, as Garage requires), GARAGE_ADMIN_TOKEN (32 B hex)
#
# Accounts (F6.2, SECURITY_ARCHITECTURE §3.4):
#   PostgreSQL  nc_owner (DDL, migrations only) · nc_app (API + worker) · nc_admin
#               (reserved for the admin instance); unix socket only
#   Redis core  ACL users nc-api and nc-worker; the default user is disabled
#   Redis gw    separate instance, ACL user nc-gateway (~nc:bff:*); default disabled
#   Objects     S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY for the bucket-only account of
#               the object store. Written here as placeholders; with Garage (S-1) nc-provision
#               replaces them by the key Garage creates for bucket NC_S3_BUCKET ("GK…").
set -eu
umask 077

CORE_DIR=/etc/novuconstruct/secrets
CORE_GROUP=novuconstruct
GW_ETC=/etc/nc-gateway
GW_DIR=$GW_ETC/secrets
GW_REDIS_ETC=/etc/nc-gateway-redis
GW_REDIS_SOCKET=/run/nc-gateway-redis/redis.sock

usage() { sed -n '2,/^set -eu$/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }

MODE=core; ACTION=create; ROTATE=""; KID=""
while [ $# -gt 0 ]; do
  case "$1" in
    --gateway) MODE=gateway ;;
    --garage) MODE=garage ;;
    --rotate) ACTION=rotate; ROTATE="${2:?usage: nc-gen-secrets --rotate NAME}"; shift ;;
    --add-gateway-hmac) ACTION=add-hmac ;;
    --drop-gateway-hmac) ACTION=drop-hmac; KID="${2:?usage: --drop-gateway-hmac KID}"; shift ;;
    --export-gateway-hmac) ACTION=export-hmac; case "${2:-}" in ''|-*) ;; *) KID=$2; shift ;; esac ;;
    --hmac-from-core) ACTION=hmac-from-core; case "${2:-}" in ''|-*) ;; *) KID=$2; shift ;; esac ;;
    --hmac-stdin) ACTION=hmac-stdin ;;
    --rotate-session-key) ACTION=rotate-session ;;
    --revoke-session-keys) ACTION=revoke-session ;;
    --rotate-redis-password) ACTION=rotate-redis ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
  shift
done

[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }

rand() { openssl rand -hex "$1"; }
b64key() { openssl rand -base64 32 | tr -d '\n'; }   # 32 random bytes, standard base64 (44 chars)
stamp() { date -u +%Y%m%d; }

# atomic write: put DIR NAME VALUE OWNER:GROUP MODE
put() {
  tmp=$(mktemp "$1/.tmp.XXXXXX")
  printf '%s' "$3" > "$tmp"
  chown "$4" "$tmp"; chmod "$5" "$tmp"
  mv -f "$tmp" "$1/$2"
  echo "written: $1/$2"
}

# kid:secret, kid [A-Za-z0-9._-]{1,32}, secret >= 32 chars, no comma/whitespace.
valid_hmac_entry() {
  printf '%s' "$1" | grep -Eqx '[A-Za-z0-9._-]{1,32}:[^,[:space:]]{32,}'
}

# pick_entry LIST KID – the entry with KID, or the LAST (newest) one when KID is empty.
pick_entry() {
  printf '%s' "$1" | tr ',' '\n' | awk -F: -v kid="$2" '
    NF >= 2 { last = $0; if (kid != "" && $1 == kid) { found = $0 } }
    END { if (kid != "") { if (found == "") exit 1; print found } else { if (last == "") exit 1; print last } }'
}

# ═════════════════════════════ Object store (Garage) ═════════════════════════
if [ "$MODE" = garage ]; then
  [ "$ACTION" = create ] || { echo "action not available with --garage" >&2; exit 2; }
  install -d -m 0755 -o root -g root /etc/nc-garage
  install -d -m 0700 -o root -g root /etc/nc-garage/secrets
  for name in GARAGE_RPC_SECRET GARAGE_ADMIN_TOKEN; do
    [ -s "/etc/nc-garage/secrets/$name" ] || put /etc/nc-garage/secrets "$name" "$(rand 32)" root:root 0600
  done
  echo "done; Garage secrets stay in /etc/nc-garage/secrets"
  exit 0
fi

# ═════════════════════════════ Web Gateway ═══════════════════════════════════
if [ "$MODE" = gateway ]; then
  getent passwd nc-gateway >/dev/null || { echo "user nc-gateway missing (nc-provision install creates it)" >&2; exit 1; }
  install -d -m 0750 -o root -g nc-gateway "$GW_ETC"
  install -d -m 0700 -o root -g root "$GW_DIR"
  install -d -m 0700 -o root -g root "$GW_REDIS_ETC"

  gput() { put "$GW_DIR" "$1" "$2" root:root 0600; }

  write_redis() {   # write_redis PASSWORD – password, URL and the ACL file stay consistent
    gput REDIS_GATEWAY_PASSWORD "$1"
    gput NC_BFF_REDIS_URL "unix://nc-gateway:$1@$GW_REDIS_SOCKET?db=0"
    hash=$(printf '%s' "$1" | sha256sum | awk '{print $1}')
    # ~nc:bff:* only; no @dangerous (FLUSHALL, KEYS, CONFIG, DEBUG, ACL, …), no pub/sub.
    put "$GW_REDIS_ETC" users.acl "user default off
user nc-gateway on #$hash resetkeys ~nc:bff:* resetchannels +@all -@dangerous -@pubsub
" root:root 0600
  }

  case "$ACTION" in
    create)
      if [ ! -e "$GW_DIR/NC_BFF_SESSION_KEYS" ]; then gput NC_BFF_SESSION_KEYS "s$(stamp)$(rand 2):$(b64key)"; fi
      if [ ! -e "$GW_DIR/REDIS_GATEWAY_PASSWORD" ] || [ ! -e "$GW_DIR/NC_BFF_REDIS_URL" ] || [ ! -e "$GW_REDIS_ETC/users.acl" ]; then
        if [ -e "$GW_DIR/REDIS_GATEWAY_PASSWORD" ]; then write_redis "$(cat "$GW_DIR/REDIS_GATEWAY_PASSWORD")"
        else write_redis "$(rand 32)"; fi
      fi
      if [ ! -e "$GW_DIR/NC_GATEWAY_HMAC_KEY" ]; then
        if [ -r "$CORE_DIR/NC_GATEWAY_HMAC_KEYS" ]; then
          entry=$(pick_entry "$(cat "$CORE_DIR/NC_GATEWAY_HMAC_KEYS")" "") || { echo "core NC_GATEWAY_HMAC_KEYS is empty" >&2; exit 1; }
          valid_hmac_entry "$entry" || { echo "core NC_GATEWAY_HMAC_KEYS has an invalid entry" >&2; exit 1; }
          gput NC_GATEWAY_HMAC_KEY "$entry"
        else
          echo "NC_GATEWAY_HMAC_KEY missing: two-server variant – on the core run" >&2
          echo "  nc-gen-secrets --export-gateway-hmac | <admin channel> | nc-gen-secrets --gateway --hmac-stdin" >&2
          echo "(GATEWAY_RUNBOOK.md, \"Instalace\"); the gateway does not start without it" >&2
        fi
      fi
      ;;
    hmac-from-core)
      [ -r "$CORE_DIR/NC_GATEWAY_HMAC_KEYS" ] || { echo "$CORE_DIR/NC_GATEWAY_HMAC_KEYS not on this host (use --hmac-stdin)" >&2; exit 1; }
      entry=$(pick_entry "$(cat "$CORE_DIR/NC_GATEWAY_HMAC_KEYS")" "$KID") || { echo "no key '${KID:-newest}' in core NC_GATEWAY_HMAC_KEYS" >&2; exit 1; }
      valid_hmac_entry "$entry" || { echo "invalid key entry (kid:secret, secret >= 32 chars)" >&2; exit 1; }
      gput NC_GATEWAY_HMAC_KEY "$entry"
      echo "now: systemctl restart nc-gateway"
      ;;
    hmac-stdin)
      IFS= read -r entry || true
      valid_hmac_entry "$entry" || { echo "stdin: expected one line kid:secret (secret >= 32 chars)" >&2; exit 1; }
      gput NC_GATEWAY_HMAC_KEY "$entry"
      echo "now: systemctl restart nc-gateway"
      ;;
    rotate-session)
      [ -e "$GW_DIR/NC_BFF_SESSION_KEYS" ] || { echo "no NC_BFF_SESSION_KEYS yet (run --gateway first)" >&2; exit 1; }
      # new key encrypts; the previous FIRST key stays for decryption (older ones are dropped:
      # sessions live at most 12 h, so two keys cover any rotation interval >= 12 h).
      previous=$(cut -d, -f1 < "$GW_DIR/NC_BFF_SESSION_KEYS")
      gput NC_BFF_SESSION_KEYS "s$(stamp)$(rand 2):$(b64key),$previous"
      echo "now: systemctl restart nc-gateway (existing sessions stay valid)"
      ;;
    revoke-session)
      gput NC_BFF_SESSION_KEYS "s$(stamp)$(rand 2):$(b64key)"
      echo "now: systemctl restart nc-gateway (every web session is invalid)"
      ;;
    rotate-redis)
      write_redis "$(rand 32)"
      echo "now: systemctl restart nc-gateway-redis nc-gateway"
      ;;
    *) echo "action not available with --gateway" >&2; exit 2 ;;
  esac
  echo "done; gateway secrets stay in $GW_DIR"
  exit 0
fi

# ═════════════════════════════ Private Core ══════════════════════════════════
getent group "$CORE_GROUP" >/dev/null || { echo "group $CORE_GROUP missing (nc-provision install creates it)" >&2; exit 1; }
install -d -m 0750 -o root -g "$CORE_GROUP" "$CORE_DIR"
DIR=$CORE_DIR

case "$ACTION" in
  add-hmac|drop-hmac|export-hmac)
    [ -e "$DIR/NC_GATEWAY_HMAC_KEYS" ] || { echo "no NC_GATEWAY_HMAC_KEYS yet (run nc-gen-secrets first)" >&2; exit 1; }
    keys=$(cat "$DIR/NC_GATEWAY_HMAC_KEYS")
    case "$ACTION" in
      add-hmac)
        put "$DIR" NC_GATEWAY_HMAC_KEYS "$keys,gw-$(stamp)-$(rand 2):$(rand 32)" root:"$CORE_GROUP" 0640
        echo "next: systemctl restart nc-api@gateway; then give the NEW key to the gateway (GATEWAY_RUNBOOK.md)"
        ;;
      drop-hmac)
        pick_entry "$keys" "$KID" >/dev/null || { echo "no key '$KID'" >&2; exit 1; }
        rest=$(printf '%s' "$keys" | tr ',' '\n' | awk -F: -v kid="$KID" '$1 != kid && NF >= 2' | paste -sd, -)
        [ -n "$rest" ] || { echo "refusing to remove the last gateway key" >&2; exit 1; }
        put "$DIR" NC_GATEWAY_HMAC_KEYS "$rest" root:"$CORE_GROUP" 0640
        echo "next: systemctl restart nc-api@gateway"
        ;;
      export-hmac)
        pick_entry "$keys" "$KID" || { echo "no key '${KID:-newest}'" >&2; exit 1; }
        ;;
    esac
    exit 0
    ;;
  rotate|create) ;;
  *) echo "action needs --gateway" >&2; exit 2 ;;
esac

write() {   # write NAME VALUE – only when missing or explicitly rotated
  name=$1; value=$2
  if [ -e "$DIR/$name" ] && [ "$ROTATE" != "$name" ]; then return 0; fi
  put "$DIR" "$name" "$value" root:"$CORE_GROUP" 0640
}

read_or() {  # existing value of NAME, or a fresh random one (hex, given bytes)
  if [ -e "$DIR/$1" ] && [ "$ROTATE" != "$1" ]; then cat "$DIR/$1"; else rand "$2"; fi
}

PG_APP=$(read_or POSTGRES_PASSWORD 24)
PG_OWNER=$(read_or POSTGRES_OWNER_PASSWORD 24)
PG_ADMIN=$(read_or POSTGRES_ADMIN_PASSWORD 24)
REDIS_API=$(read_or REDIS_PASSWORD 24)
REDIS_WORKER=$(read_or REDIS_WORKER_PASSWORD 24)
S3_SECRET=$(read_or S3_SECRET_ACCESS_KEY 32)

write POSTGRES_PASSWORD "$PG_APP"
write POSTGRES_OWNER_PASSWORD "$PG_OWNER"
write POSTGRES_ADMIN_PASSWORD "$PG_ADMIN"
write REDIS_PASSWORD "$REDIS_API"
write REDIS_WORKER_PASSWORD "$REDIS_WORKER"
write JWT_SECRET "$(rand 32)"
write METRICS_AUTH_TOKEN "$(rand 32)"
write S3_ACCESS_KEY_ID "nc-app-$(rand 6)"
write S3_SECRET_ACCESS_KEY "$S3_SECRET"
# Gateway → core service identity (F3.4): "kid:secret"; only nc-api@gateway loads it.
# Rotation: --add-gateway-hmac / --drop-gateway-hmac (not --rotate: that would cut the gateway off).
write NC_GATEWAY_HMAC_KEYS "gw-$(stamp):$(rand 32)"

# PostgreSQL over its unix socket only (listen_addresses = '').
SOCK="host=/var/run/postgresql"
write DATABASE_URL "postgresql+asyncpg://nc_app:${PG_APP}@/novuconstruct?${SOCK}"
write DATABASE_URL_SYNC "postgresql+psycopg://nc_app:${PG_APP}@/novuconstruct?${SOCK}"
# Owner role: migrations and retention only (bin/nc-migrate), never a service.
write DATABASE_URL_OWNER "postgresql+asyncpg://nc_owner:${PG_OWNER}@/novuconstruct?${SOCK}"
write DATABASE_URL_OWNER_SYNC "postgresql+psycopg://nc_owner:${PG_OWNER}@/novuconstruct?${SOCK}"
write REDIS_URL "redis://nc-api:${REDIS_API}@127.0.0.1:6379/0"
write REDIS_URL_WORKER "redis://nc-worker:${REDIS_WORKER}@127.0.0.1:6379/0"
[ -e "$DIR/ANTHROPIC_API_KEY" ] || write ANTHROPIC_API_KEY "REPLACE_WITH_REAL_KEY"
echo "done; secrets stay in $DIR"
