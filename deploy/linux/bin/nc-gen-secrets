#!/bin/sh
# Generate Private Core secrets on the server (F6.5). Run once as root:
#   /opt/novuconstruct/deploy/linux/bin/nc-gen-secrets
# Writes /etc/novuconstruct/secrets/<NAME> (0640 root:novuconstruct). Values are
# never printed, logged or written anywhere else. Existing files are kept unless
# --rotate NAME is given (rotate one secret, then restart the services).
# PostgreSQL/Redis/MinIO must be configured with the generated passwords
# (README.md "Install", steps 4-6) – the helper prints only which files changed.
set -eu
umask 077

DIR=/etc/novuconstruct/secrets
GROUP=novuconstruct
ROTATE=""
if [ "${1:-}" = "--rotate" ]; then ROTATE="${2:?usage: nc-gen-secrets [--rotate NAME]}"; fi

[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
getent group "$GROUP" >/dev/null || { echo "group $GROUP missing (README step 1)" >&2; exit 1; }
install -d -m 0750 -o root -g "$GROUP" "$DIR"

rand() { openssl rand -hex "$1"; }

write() {   # write NAME VALUE – only when missing or explicitly rotated
  name=$1; value=$2; path="$DIR/$name"
  if [ -e "$path" ] && [ "$ROTATE" != "$name" ]; then return 0; fi
  tmp=$(mktemp "$DIR/.tmp.XXXXXX")
  printf '%s' "$value" > "$tmp"
  chown root:"$GROUP" "$tmp"; chmod 0640 "$tmp"
  mv -f "$tmp" "$path"
  echo "written: $path"
}

read_or() {  # existing value of NAME, or a fresh random one
  if [ -e "$DIR/$1" ] && [ "$ROTATE" != "$1" ]; then cat "$DIR/$1"; else rand "$2"; fi
}

PG_PASSWORD=$(read_or POSTGRES_PASSWORD 24)
REDIS_PASSWORD=$(read_or REDIS_PASSWORD 24)
S3_SECRET=$(read_or S3_SECRET_ACCESS_KEY 32)

write POSTGRES_PASSWORD "$PG_PASSWORD"
write REDIS_PASSWORD "$REDIS_PASSWORD"
write JWT_SECRET "$(rand 32)"
write METRICS_AUTH_TOKEN "$(rand 32)"
write S3_ACCESS_KEY_ID "nc-app-$(rand 6)"
write S3_SECRET_ACCESS_KEY "$S3_SECRET"
write MINIO_ROOT_PASSWORD "$(rand 32)"
# Loopback/unix only; the application role, never the owner role (F6.2).
write DATABASE_URL "postgresql+asyncpg://nc_app:${PG_PASSWORD}@127.0.0.1:5432/novuconstruct"
write DATABASE_URL_SYNC "postgresql+psycopg://nc_app:${PG_PASSWORD}@127.0.0.1:5432/novuconstruct"
write REDIS_URL "redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0"
[ -e "$DIR/ANTHROPIC_API_KEY" ] || write ANTHROPIC_API_KEY "REPLACE_WITH_REAL_KEY"
echo "done; secrets stay in $DIR"
