# =========================================
# NODE / FRONTEND
# =========================================
node_modules/

# =========================================
# ENVIRONMENT (CRITICAL — NEVER COMMIT SECRETS)
# =========================================
.env
.env.*
!.env.example
!.env.production.example

# also cover subdirectories
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# =========================================
# PYTHON
# =========================================
__pycache__/
*.pyc
*.pyo
*.pyd

src/backend/.venv/

# Coverage data (pytest --cov) – lokální artefakt, necommitovat
.coverage
.coverage.*

# =========================================
# DATABASES (LOCAL / TEST ONLY)
# =========================================
*.db
*.sqlite3

prisma/dev.db
src/backend/python-backend.db
python-backend.db

# =========================================
# LOGS
# =========================================
*.log
src/backend/log-test-*.json
src/backend/.log-test-*.json
**/log-test-*.json
**/.log-test-*.json

# =========================================
# TEMP / RUNTIME FILES
# =========================================
tmp_*
**/tmp_*
*_tmp/
temp/
**/temp/

pytest-local/
tmp_pytest/
tmp_pytest_orch/
docs/.pdf-build/

src/backend/tmp_test_runtime/
src/backend/tmp_*

# =========================================
# RUNTIME STATE (NEVER VERSION)
# =========================================
**/session_*/
**/*heartbeat*.json

# =========================================
# STORAGE / ARTIFACTS (RUNTIME DATA)
# =========================================
storage/
# Zdrojový balíček backendu se jmenuje stejně jako lokální úložiště – nesmí se ignorovat.
!src/backend/app/storage/
backups/
artifacts/
**/artifacts/

# =========================================
# DEBUG / VALIDATION
# =========================================
.codex_tmp_validation/
.debug_*/
_debug_*/
**/.codex_tmp_validation/
**/.debug_*/

# =========================================
# CERTIFICATES / SECRETS
# =========================================
nginx/certs/*.pem

# =========================================
# IDE / LOCAL TOOLS
# =========================================
.vscode/
src/desktop/.qtcreator/
.claude/

# Personal editor / AI-tool metadata and generated code indexes (not shared)
.workspace/
.novuai/
.novu/
*.code-workspace

# =========================================
# WEB FRONTEND BUILD ARTIFACTS
# =========================================
src/frontend/dist/
src/frontend/*.tsbuildinfo
src/frontend/tsconfig.node.tsbuildinfo
src/frontend/vite.config.js
src/frontend/vite.config.d.ts
src/frontend/vite.config.placeholder.js
src/frontend/vite.config.placeholder.d.ts
src/frontend/vite.config.placeholder.ts
# compiled JS outputs alongside TS/TSX source files
src/frontend/src/**/*.js

# =========================================
# WINDOWS GENERATED DIRECTORY LISTINGS
# =========================================
files.txt
structure.txt

# =========================================
# MISC
# =========================================
my-app/
docs/*.pdf

# =========================================
# GENERATED BUILD ARTIFACTS
# =========================================
# Product Book: NOVU_MASTER_PRODUCT_BOOK.md is the source of truth.
# The PDF and the intermediate HTML are reproducible via
# `node .pdfbuild/build.mjs` — the build script itself stays versioned.
.pdfbuild/book.html
NOVU_MASTER_PRODUCT_BOOK.pdf

# Qt desktop packaging output (windeployqt / Package-Pilot.ps1)
src/desktop/dist/
