# =========================================
# NODE / FRONTEND
# =========================================
node_modules/

# =========================================
# ENVIRONMENT (CRITICAL — NEVER COMMIT SECRETS)
# =========================================
.env
.env.*
!.env.example
!.env.production.example

# also cover subdirectories
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# =========================================
# PYTHON
# =========================================
__pycache__/
*.pyc
*.pyo
*.pyd

python-backend/.venv/

# =========================================
# DATABASES (LOCAL / TEST ONLY)
# =========================================
*.db
*.sqlite3

prisma/dev.db
python-backend/python-backend.db
python-backend.db

# =========================================
# LOGS
# =========================================
*.log
python-backend/log-test-*.json
python-backend/.log-test-*.json
**/log-test-*.json
**/.log-test-*.json

# =========================================
# TEMP / RUNTIME FILES
# =========================================
tmp_*
**/tmp_*
*_tmp/
temp/
**/temp/

pytest-local/
tmp_pytest/
tmp_pytest_orch/
docs/.pdf-build/

python-backend/tmp_test_runtime/
python-backend/tmp_*

# =========================================
# RUNTIME STATE (NEVER VERSION)
# =========================================
**/session_*/
**/*heartbeat*.json

# =========================================
# STORAGE / ARTIFACTS (RUNTIME DATA)
# =========================================
storage/
backups/
artifacts/
**/artifacts/

# =========================================
# DEBUG / VALIDATION
# =========================================
.codex_tmp_validation/
.debug_*/
_debug_*/
**/.codex_tmp_validation/
**/.debug_*/

# =========================================
# CERTIFICATES / SECRETS
# =========================================
nginx/certs/*.pem

# =========================================
# IDE / LOCAL TOOLS
# =========================================
.vscode/
desktop-qt/.qtcreator/
.claude/

# =========================================
# WEB FRONTEND BUILD ARTIFACTS
# =========================================
web/dist/
web/*.tsbuildinfo
web/tsconfig.node.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
web/vite.config.placeholder.js
web/vite.config.placeholder.d.ts
web/vite.config.placeholder.ts
# compiled JS outputs alongside TS/TSX source files
web/src/**/*.js

# =========================================
# WINDOWS GENERATED DIRECTORY LISTINGS
# =========================================
files.txt
structure.txt

# =========================================
# MISC
# =========================================
my-app/
