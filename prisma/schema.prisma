generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  ico             String?
  email           String?
  phone           String?
  defaultCurrency String           @default("CZK")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  clients         Client[]
  projects        Project[]
  pricingProfiles PricingProfile[]
  materialCatalog MaterialCatalog[]
  suppliers       Supplier[]
}

model User {
  id              String        @id @default(cuid())
  organizationId  String
  email           String        @unique
  passwordHash    String
  fullName        String
  role            String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdProjects Project[]     @relation("ProjectCreator")
  analysisJobs    AnalysisJob[]
}

model Client {
  id             String        @id @default(cuid())
  organizationId String
  fullName       String
  companyName    String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
}

model Project {
  id              String          @id @default(cuid())
  organizationId  String
  clientId        String?
  createdByUserId String
  title           String
  description     String?
  status          String          @default("draft")
  propertyType    String?
  repairScope     String?
  locationLat     Float?
  locationLng     Float?
  addressLabel    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser   User            @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  photos          ProjectPhoto[]
  analysisJobs    AnalysisJob[]
  analysisResults AnalysisResult[]
  quoteVariants   QuoteVariant[]
}

model ProjectPhoto {
  id                String   @id @default(cuid())
  projectId         String
  storageKey        String
  previewStorageKey String?
  aiInputStorageKey String?
  originalFilename  String
  mimeType          String
  fileSize          Int      @default(0)
  width             Int?
  height            Int?
  previewFileSize   Int?
  previewWidth      Int?
  previewHeight     Int?
  aiInputFileSize   Int?
  aiInputWidth      Int?
  aiInputHeight     Int?
  processingStatus  String   @default("ready")
  takenAt           DateTime?
  exifLat           Float?
  exifLng           Float?
  isPrimary         Boolean  @default(false)
  sortOrder         Int      @default(1)
  createdAt         DateTime @default(now())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AnalysisJob {
  id                String          @id @default(cuid())
  projectId         String
  status            String
  jobType           String
  requestedByUserId String?
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedByUser   User?           @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  analysisResults   AnalysisResult[]
}

model AnalysisResult {
  id                      String         @id @default(cuid())
  projectId               String
  analysisJobId           String?
  referencePhotoId        String?
  objectType              String?
  surfaceCondition        String?
  recommendedScope        String?
  estimatedAreaSqm        Float?
  areaConfidence          Float?
  selectedRepairPolygonJson String?
  manualAreaSqm           Float?
  finalAreaSource         String         @default("ai")
  maskPolygonJson         String?
  materialsSuggestionJson String?
  workflowSuggestionJson  String?
  modelName               String?
  modelVersion            String?
  createdAt               DateTime       @default(now())
  project                 Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisJob             AnalysisJob?   @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  quoteVariants           QuoteVariant[]
}

model PricingProfile {
  id                String         @id @default(cuid())
  organizationId    String
  name              String
  hourlyRate        Float
  dailyRate         Float
  laborHoursPerSqm  Float          @default(0.3)
  marginEconomyPct  Float
  marginStandardPct Float
  marginPremiumPct  Float
  vatPct            Float          @default(21)
  currency          String         @default("CZK")
  isDefault         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteVariants     QuoteVariant[]
}

model MaterialCatalog {
  id               String                  @id @default(cuid())
  organizationId   String
  name             String
  category         String?
  unit             String
  normPerSqm       Float
  defaultUnitPrice Float
  defaultSupplierId String?
  isActive         Boolean                 @default(true)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultSupplier  Supplier?               @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  supplierPrices   SupplierMaterialPrice[]
  quoteItems       QuoteItem[]
}

model Supplier {
  id                 String                  @id @default(cuid())
  organizationId     String
  name               String
  code               String?
  websiteUrl         String?
  integrationType    String                  @default("manual")
  isActive           Boolean                 @default(true)
  contactName        String?
  contactEmail       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultForMaterials MaterialCatalog[]      @relation("DefaultSupplier")
  supplierPrices     SupplierMaterialPrice[]
  quoteItems         QuoteItem[]
}

model SupplierMaterialPrice {
  id                         String          @id @default(cuid())
  materialCatalogId          String
  supplierId                 String
  supplierProductName        String?
  supplierSku                String?
  unit                       String
  unitPrice                  Float
  currency                   String          @default("CZK")
  availabilityStatus         String?
  sourceType                 String          @default("manual")
  sourceUrl                  String?
  validFrom                  DateTime?
  validTo                    DateTime?
  lastSeenAt                 DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  materialCatalog            MaterialCatalog @relation(fields: [materialCatalogId], references: [id], onDelete: Cascade)
  supplier                   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model QuoteVariant {
  id               String          @id @default(cuid())
  projectId        String
  analysisResultId String?
  pricingProfileId String?
  variantType      String
  laborCost        Float
  materialCost     Float
  otherCost        Float
  marginPct        Float
  totalExVat       Float
  vatAmount        Float
  totalIncVat      Float
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisResult   AnalysisResult? @relation(fields: [analysisResultId], references: [id], onDelete: SetNull)
  pricingProfile   PricingProfile? @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)
  items            QuoteItem[]
}

model QuoteItem {
  id                         String           @id @default(cuid())
  quoteVariantId             String
  itemType                   String
  name                       String
  description                String?
  quantity                   Float
  unit                       String
  unitPrice                  Float
  totalPrice                 Float
  materialCatalogId          String?
  supplierId                 String?
  priceSource                String           @default("company_catalog")
  isManualOverride           Boolean          @default(false)
  aiSuggestedUnitPrice       Float?
  supplierReferenceUnitPrice Float?
  companyDefaultUnitPrice    Float?
  sortOrder                  Int              @default(1)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  quoteVariant               QuoteVariant     @relation(fields: [quoteVariantId], references: [id], onDelete: Cascade)
  materialCatalog            MaterialCatalog? @relation(fields: [materialCatalogId], references: [id], onDelete: SetNull)
  supplier                   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}
